{
  "name": "nodejs-project-example",
  "description": "This is the structure for a Node.js project.",
  "version": "2.0.0",
  "author": "Alejandro Santiago Nieto",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^4.0.7",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^4.0.7"
  },
  "type": "module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    "import": "./index.js",
    "require": "./index.cjs"
  },
  "files": [
    "index.cjs",
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "lint": "eslint *.js *.cjs lib/**/*.js test/**/*.js scripts/**/*.js",
    "lint:fix": "npm run lint -- --fix",
    "types": "tsc",
    "types:generate": "tsc -p tsconfig.types.json && node scripts/fix-declaration.js",
    "check": "npm test && npm run lint && npm run types",
    "prepack": "npm run check && npm run types:generate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alemures/nodejs-project-example.git"
  }
}
